{
  "name": "handleseal",
  "version": "0.1.0",
  "private": true,
  "description": "Seal your X handle to your wallet with a Primus zkTLS proof.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test:contracts": "sh scripts/forge.sh test -vv",
    "build:contracts": "sh scripts/forge.sh build",
    "chain": "anvil --block-time 2",
    "deploy:local": "sh scripts/deploy.sh local",
    "deploy:bsc-testnet": "sh scripts/deploy.sh bsc_testnet",
    "test:e2e": "sh scripts/forge.sh build && node test/e2e-local.js"
  },
  "dependencies": {
    "@primuslabs/zktls-js-sdk": "^0.3.15",
    "ethers": "^6.17.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/contracts-upgradeable": "^5.1.0",
    "@primuslabs/zktls-contracts": "^0.1.0",
    "vite": "^6.4.6"
  },
  "engines": {
    "node": ">=22.9"
  }
}
