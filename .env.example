# Copy this file to .env and fill in the two Primus values.
# .env is in .gitignore, never commit it.

# From Primus Developer Hub > My Projects (a "DApp" project)
PRIMUS_APP_ID=
PRIMUS_APP_SECRET=

# X Account Ownership template from the Templates Market (already filled in)
PRIMUS_TEMPLATE_ID=2e3160ae-8b1e-45e3-8c59-426366278b9d

# 31337 = local Anvil, 97 = BNB Smart Chain Testnet, 56 = BNB Smart Chain
CHAIN_ID=31337

# Only needed to deploy to a public network. Use a fresh wallet made for this demo.
DEPLOYER_PRIVATE_KEY=

# Optional: link to the public GitHub repo, shown in the footer
SOURCE_URL=

# Optional: twitterapi.io key for profile pictures and names (server side only)
TWITTER_API_KEY=
